# Clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé comme cerveau (rapide et pas cher par défaut)
# Pour un bot plus malin mais plus cher : claude-sonnet-5-5
MODEL=claude-haiku-5-5
# Temps de réflexion : low (rapide, pas cher), medium, high (plus malin mais plus lent)
EFFORT=low
# Dépense max par jour (en dollars) avant de repasser automatiquement sur claude-haiku-5-5
BUDGET_USD=8

# Ton pseudo Minecraft : le bot t'écoute toujours
OWNER=TonPseudo

# Connexion au monde
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Claude
# offline = serveur avec online-mode=false ; microsoft = vrai compte Microsoft
MC_AUTH=offline
# Laisse vide pour détection automatique, sinon ex : 1.21.4
MC_VERSION=

# true = répond à tous les joueurs ; false = seulement à toi, ou si on dit son nom
RESPOND_ALL=false
